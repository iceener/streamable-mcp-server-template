{
  "name": "mcp-server-template",
  "version": "1.0.0",
  "description": "MCP 2026-07-28 server template for Bun and Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "dev:worker": "wrangler dev",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "build:worker": "wrangler deploy --dry-run --outdir dist/worker",
    "deploy": "wrangler deploy",
    "deploy:tail": "wrangler tail",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "types:worker": "wrangler types",
    "types:worker:check": "wrangler types --check",
    "test": "bun test",
    "test:protocol": "bun test tests/protocol.test.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "streamable-http",
    "cloudflare-workers",
    "bun",
    "oauth-resource-server"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0-beta.5",
    "hono": "^4.11.7",
    "jose": "^6.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@cloudflare/workers-types": "^5.20260727.1",
    "@modelcontextprotocol/client": "2.0.0-beta.5",
    "@types/node": "^24.10.0",
    "bun-types": "latest",
    "typescript": "^5.9.3",
    "wrangler": "^4.114.0"
  },
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=20.0.0"
  }
}
