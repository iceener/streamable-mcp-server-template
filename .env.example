# Local settings for `bun run dev`. Copy to .env; every line is optional.
# Workers read wrangler.jsonc instead (and .dev.vars, if you create one).

# development | production | test
NODE_ENV=development
# debug | info | warning | error
LOG_LEVEL=info

# Where Bun listens.
HOST=127.0.0.1
PORT=3000

# Public URL of the MCP endpoint, written canonically. Also the OAuth resource identifier.
# Defaults to http://127.0.0.1:$PORT/mcp outside production; required in production.
# MCP_PUBLIC_URL=http://127.0.0.1:3000/mcp

# Hostnames accepted in Host and Origin headers: lowercase, no scheme, no port.
# Default: the public URL's hostname, plus localhost, 127.0.0.1 and [::1] outside production.
# Origins may also list a browser-extension scheme, e.g. moz-extension://*
# MCP_ALLOWED_HOSTS=mcp.example.com
# MCP_ALLOWED_ORIGIN_HOSTNAMES=mcp.example.com

# stateless: also serve 2025-era clients. reject: 2026-07-28 clients only.
# MCP_LEGACY_MODE=stateless
# Largest request body in bytes. Default: the SDK's 4 MiB.
# MCP_MAX_REQUEST_BYTES=4194304

# none | bearer | oauth. Required in production.
AUTH_MODE=none

# AUTH_MODE=bearer: every client sends this token as `Authorization: Bearer <token>`.
# Generate one with `openssl rand -hex 32`. On Workers, store it with `wrangler secret put`.
# BEARER_TOKEN=

# AUTH_MODE=oauth: tokens come from an external authorization server.
# `bun run token` starts a local one for testing and prints matching values (docs/auth.md).
# OAUTH_ISSUER_URL=https://auth.example.com
# OAUTH_AUTHORIZATION_URL=https://auth.example.com/oauth2/authorize
# OAUTH_TOKEN_URL=https://auth.example.com/oauth2/token
# Needed by the built-in JWT verifier (createVerifier in src/server.ts).
# OAUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json
# OAUTH_REGISTRATION_URL=https://auth.example.com/oauth2/register
# Scopes every request needs, space- or comma-separated. Tools can require more.
# OAUTH_SCOPES=mcp

# Your own settings, declared in src/settings.ts.
# Open-Meteo commercial API key. The free API needs none.
# OPEN_METEO_API_KEY=
