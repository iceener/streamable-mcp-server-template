# Bun server
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# MCP identity and HTTP endpoint
MCP_NAME=mcp-server-template
MCP_TITLE="My MCP Server"
MCP_VERSION=1.0.0
MCP_DESCRIPTION="A modern MCP server."
MCP_INSTRUCTIONS="Use the available tools and resources."
# Canonical URL spelling; no query, fragment, userinfo, or whitespace.
# HTTPS in production; HTTP only for loopback development/tests.
MCP_PUBLIC_URL=http://localhost:3000/mcp
# MCP_WEBSITE_URL=https://docs.example.com

# DNS rebinding and browser-origin protection (hostnames only, comma-separated)
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
MCP_ALLOWED_ORIGIN_HOSTNAMES=localhost,127.0.0.1,[::1]

# "stateless" supports 2025-era clients; "reject" serves only 2026-07-28
MCP_LEGACY_MODE=stateless
# Bounded before the SDK parses JSON (1 MiB default, 10 MiB hard maximum)
MCP_MAX_REQUEST_BYTES=1048576

# Optional OAuth Resource Server mode. The Authorization Server is external.
AUTH_ENABLED=false
# OAUTH_ISSUER_URL=https://auth.example.com
# OAUTH_AUTHORIZATION_URL=https://auth.example.com/authorize
# OAUTH_TOKEN_URL=https://auth.example.com/token
# OAUTH_REGISTRATION_URL=https://auth.example.com/register
# OAUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json
# Must exactly equal MCP_PUBLIC_URL; defaults to that exact string if omitted.
# OAUTH_AUDIENCE=https://mcp.example.com/mcp
# OAUTH_REQUIRED_SCOPES=mcp:read,mcp:write
# OAUTH_JWT_ALGORITHMS=RS256,ES256
# OAUTH_CLIENT_ID_CLAIM=client_id
# Mirror the external Authorization Server's actual RFC 8414 metadata:
# OAUTH_RESPONSE_TYPES_SUPPORTED=code
# OAUTH_GRANT_TYPES_SUPPORTED=authorization_code
# OAUTH_CODE_CHALLENGE_METHODS_SUPPORTED=S256
